  "rules": [
    {"when": {"press": "arrow"}, "do": [{"move": "same"}]},
    {"when": {"bump": ["you", "c"]}, "do": [{"move": "same", "who": "bumped"}]},
    {"when": {"bump": ["you", "s"]}, "do": [{"move": "same", "who": "bumped"}]},
    {
      "when": {"bump": ["c", "o"]},
      "do": [
