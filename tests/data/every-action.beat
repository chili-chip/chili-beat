    {
      "id": "two",
      "map": [1, 0],
      "reset": true,
      "things": [
        "################",
        "#..............#",
        "#..............#",
        "#..............#",
        "#.......x......#",
        "#..............#",
        "#..............#",
        "...............#",
        "#..............#",
        "#..............#",
        "#..............#",
        "#..............#",
        "#..............#",
        "#..............#",
        "#..............#",
        "################"
      ]
    }
  ],
  "rules": [
    {"when": {"press": "arrow"}, "do": [{"move": "same"}]},
    {"when": {"start": true}, "do": [{"say": "Find the key."}]},
    {"when": {"press": "b"}, "do": [{"become": "g"}, {"sound": "zap"}]},
    {"when": {"press": "a"}, "do": [{"turn": "back"}]},
    {
      "when": {"bump": ["you", "$"]},
      "do": [{"vanish": true, "who": "bumped"}, {"count": "coins", "add": 1}]
    },
    {
      "when": {"bump": ["you", "k"]},
      "do": [{"vanish": true, "who": "bumped"}, {"count": "keys", "set": 1}]
    },
    {
      "when": {"bump": ["you", "d"]},
      "if": [{"counter": "keys", "exactly": 1}],
      "do": [{"vanish": true, "who": "bumped"}, {"count": "keys", "add": -1}]
    },
    {"when": {"every": 2, "thing": "r"}, "if": [{"chance": 2}], "do": [{"move": "random"}]},
    {"when": {"every": 4, "thing": "r"}, "do": [{"move": "away"}, {"make": "t", "to": "back"}]},
    {"when": {"every": 8, "thing": "t"}, "do": [{"vanish": true}]},
    {"when": {"bump": ["r", "any"]}, "do": [{"turn": "random"}, {"move": "forward"}]},
    {
      "when": {"bump": ["any", "r"]},
      "do": [
        {"shake": true},
        {"move": "left", "who": "bumped"},
        {"move": "right", "who": "bumped"},
        {"move": "up", "who": "bumped"},
        {"move": "down", "who": "bumped"}
      ]
    },
    {"when": {"counter": "coins", "reaches": 3}, "do": [{"go": "two"}]},
    {
      "when": {"bump": ["you", "x"]},
      "if": [{"counter": "coins", "atMost": 2}],
      "do": [{"lose": "Not enough coins."}]
    },
    {
      "when": {"bump": ["you", "x"]},
      "if": [{"counter": "coins", "atLeast": 3}],
      "do": [{"win": "You did everything!"}]
    },
    {"when": {"bump": ["you", "#"]}, "do": [{"move": "toward", "who": "bumped"}]}
  ],
  "blips": [{"id": "zap", "preset": "power", "pitch": 6, "length": 2, "slide": 5}],
  "tunes": [
    {
      "id": "march",
      "scale": "minor",
      "lead": [1, 3, 5, 8, 5, 3, 1, 0, 2, 4, 6, 9, 6, 4, 2, 0],
      "beat": [8, 0, 10, 0, 9, 0, 10, 0, 8, 8, 10, 0, 9, 0, 10, 10]
    }
  ]
}
