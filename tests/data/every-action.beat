  "screens": [
    {
      "id": "one",
      "map": [0, 0],
      "tune": "march",
      "things": [
        "################",
        "#..............#",
        "#.$..$..$......#",
        "#..............#",
        "#.......r......#",
        "#..............#",
        "#..k...........#",
        "#...............",
