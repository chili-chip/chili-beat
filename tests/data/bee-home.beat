  "rules": [
    {"when": {"press": "arrow"}, "do": [{"move": "same"}]},
    {
      "when": {"bump": ["b", "f"]},
      "do": [{"become": "u", "who": "bumped"}, {"count": "pollen", "add": 1}, {"sound": "coin"}]
    },
    {"when": {"every": 8, "thing": "u"}, "do": [{"become": "f"}]},
    {"when": {"every": 2, "thing": "w"}, "do": [{"move": "toward"}]},
    {"when": {"bump": ["w", "b"]}, "do": [{"shake": true}, {"lose": "Stung! Try again."}]},
    {
      "when": {"bump": ["b", "h"]},
      "if": [{"counter": "pollen", "atLeast": 5}],
      "do": [{"win": "The hive is happy."}]
    },
    {
      "when": {"bump": ["b", "h"]},
      "if": [{"counter": "pollen", "atMost": 4}],
      "do": [{"say": "Bring me 5 pollen."}]
    }
  ],
  "blips": [{"id": "coin", "preset": "coin", "pitch": 5, "length": 2, "slide": 3}],
  "tunes": [
    {
      "id": "main",
      "scale": "pentatonic-major",
